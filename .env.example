# Avantis Trader SDK starter environment
#
# Copy to .env (git-ignored) and fill in the two required values. The SDK
# reads AVANTIS_* from the process environment, so load the file first:
#
#     set -a; source .env; set +a        # shell
#     # or: pip install python-dotenv && load_dotenv() before AsyncAvantis()
#
#     from avantis_trader_sdk import AsyncAvantis
#     client = AsyncAvantis()            # picks up AVANTIS_* automatically

# --- required -----------------------------------------------------------

# Signing key. Recommended: an API/agent key created with the Avantis API
# Key Generator (https://delegate.avantisfi.com/),
# a "delegate" key that can trade but not withdraw. Using your wallet's
# own private key also works; leave AVANTIS_TRADER_ADDRESS unset then.
AVANTIS_PRIVATE_KEY=0xYOUR_API_OR_AGENT_KEY

# Your wallet address (the account that holds the USDC and the positions).
# Only needed when AVANTIS_PRIVATE_KEY is a delegate/API key, i.e. when the
# key's address differs from your wallet.
AVANTIS_TRADER_ADDRESS=0xYOUR_WALLET_ADDRESS

# --- optional -----------------------------------------------------------

# "mainnet" (default) or "testnet" (the Avantis staging stack, for rehearsals).
# AVANTIS_NETWORK=testnet

# Execution route: "relayer" (default; gasless, no ETH or RPC needed) or
# "direct" (sign and broadcast yourself; requires AVANTIS_RPC_URL and ETH
# for gas).
# AVANTIS_EXECUTION=relayer
# AVANTIS_RPC_URL=https://mainnet.base.org

# Per-service endpoint overrides (rarely needed; defaults come from the
# network profile in avantis_trader_sdk/config.py):
# AVANTIS_API_BASE_URL=
# AVANTIS_TX_BUILDER_URL=
# AVANTIS_RELAYER_URL=
# AVANTIS_DATA_API_URL=
# AVANTIS_CORE_API_URL=
# AVANTIS_TWAP_API_URL=
# AVANTIS_BATCHED_MARKET_URL=
# AVANTIS_RISK_V2_API_URL=
# AVANTIS_HISTORY_API_URL=
# AVANTIS_RISK_API_URL=
# AVANTIS_FEED_URL=

# AWS KMS signer (optional extra: pip install 'avantis-trader-sdk[kms]';
# pass KmsSigner(...) to the client instead of AVANTIS_PRIVATE_KEY):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
