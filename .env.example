# Veranta Trader SDK starter environment
#
# Copy to .env (git-ignored) and fill in the two required values. The SDK
# reads VERANTA_* from the process environment, so load the file first:
#
#     set -a; source .env; set +a        # shell
#     # or: pip install python-dotenv && load_dotenv() before AsyncVeranta()
#
#     from veranta_sdk import AsyncVeranta
#     client = AsyncVeranta()            # picks up VERANTA_* automatically

# --- required -----------------------------------------------------------

# Signing key. Recommended: an API/agent key created with the Veranta API
# Key Generator (https://delegate.veranta.xyz/),
# a "delegate" key that can trade but not withdraw. Using your wallet's
# own private key also works; leave VERANTA_TRADER_ADDRESS unset then.
VERANTA_PRIVATE_KEY=0xYOUR_API_OR_AGENT_KEY

# Your wallet address (the account that holds the USDC and the positions).
# Only needed when VERANTA_PRIVATE_KEY is a delegate/API key, i.e. when the
# key's address differs from your wallet.
VERANTA_TRADER_ADDRESS=0xYOUR_WALLET_ADDRESS

# --- optional -----------------------------------------------------------

# "mainnet" (default) or "testnet" (the Veranta staging stack, for rehearsals).
# VERANTA_NETWORK=testnet

# Execution route: "relayer" (default; gasless, no ETH or RPC needed) or
# "direct" (sign and broadcast yourself; requires VERANTA_RPC_URL and ETH
# for gas).
# VERANTA_EXECUTION=relayer
# VERANTA_RPC_URL=https://mainnet.base.org

# Per-service endpoint overrides (rarely needed; defaults come from the
# network profile in veranta_sdk/config.py):
# VERANTA_API_BASE_URL=
# VERANTA_TX_BUILDER_URL=
# VERANTA_RELAYER_URL=
# VERANTA_DATA_API_URL=
# VERANTA_CORE_API_URL=
# VERANTA_TWAP_API_URL=
# VERANTA_BATCHED_MARKET_URL=
# VERANTA_RISK_V2_API_URL=
# VERANTA_HISTORY_API_URL=
# VERANTA_RISK_API_URL=
# VERANTA_FEED_URL=

# AWS KMS signer (optional extra: pip install 'veranta-sdk[kms]';
# pass KmsSigner(...) to the client instead of VERANTA_PRIVATE_KEY):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
